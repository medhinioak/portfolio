---
/** The one template for every case study: header, details, optional hero, Markdown body, previous/next. */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Arrow from '../components/Arrow.astro';
import BaseLayout from './BaseLayout.astro';

type Project = CollectionEntry<'projects'>;

interface Props {
  project: Project;
  previous?: Project;
  next?: Project;
}

const { project, previous, next } = Astro.props;
const { title, summary, role, timeframe, team, context, stack } = project.data;
const { codeUrl, demoUrl, hero } = project.data;

const details = [
  { term: 'Role', value: role },
  { term: 'Timeframe', value: timeframe },
  { term: 'Team', value: team },
  { term: 'Context', value: context },
];
---

<BaseLayout title={`${title} · Medhini Oak`} description={summary}>
  <article class="case-study">
    <header class="header">
      <a class="button button-secondary button-small" href="/projects/">
        <Arrow direction="left" />
        All projects
      </a>
      <h1 class="title-long">{title}</h1>
      <p class="summary muted">{summary}</p>

      <dl class="card details">
        {details.map(({ term, value }) => (
          <div>
            <dt class="label muted">{term}</dt>
            <dd>{value}</dd>
          </div>
        ))}
        <div class="stack">
          <dt class="label muted">Stack</dt>
          <dd>
            <ul class="chips" role="list">
              {stack.map((item) => (
                <li class="chip">{item}</li>
              ))}
            </ul>
          </dd>
        </div>
      </dl>

      <div class="row actions">
        <a class="button button-primary" href={codeUrl}>
          View code
          <Arrow direction="right" />
        </a>
        {demoUrl && (
          <a class="button button-secondary" href={demoUrl}>
            Live demo
            <Arrow direction="right" />
          </a>
        )}
      </div>
    </header>

    {hero && (
      <figure class="hero">
        <Image
          src={hero.image}
          alt={hero.alt}
          loading="eager"
          fetchpriority="high"
          widths={[480, 736, 1472]}
          sizes="(min-width: 48em) 46rem, calc(100vw - 2rem)"
        />
        {hero.caption && <figcaption>{hero.caption}</figcaption>}
      </figure>
    )}

    <div class="body">
      <slot />
    </div>

    {(previous || next) && (
      <nav class="pager" aria-label="More case studies">
        {previous && (
          <a
            class="button button-secondary button-small"
            href={`/projects/${previous.id}/`}
            aria-label={`Previous project: ${previous.data.title}`}
          >
            <Arrow direction="left" />
            Previous project
          </a>
        )}
        {next && (
          <a
            class="button button-secondary button-small next"
            href={`/projects/${next.id}/`}
            aria-label={`Next project: ${next.data.title}`}
          >
            Next project
            <Arrow direction="right" />
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .header {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  .summary {
    font-size: var(--text-lg);
  }

  .details {
    width: 100%;
    gap: var(--space-4);
  }

  .stack {
    grid-column: 1 / -1;
  }

  .actions {
    width: 100%;
  }

  /* Text figures for the hero and for images in the Markdown body. */
  .case-study :global(figure) {
    display: grid;
    gap: var(--space-2);
  }

  /* Images keep their natural size up to the column width; the hero fills it. */
  .hero :global(img) {
    width: 100%;
  }

  .case-study :global(figure img) {
    height: auto;
    border-radius: var(--radius);
  }

  .case-study :global(figcaption) {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .hero {
    margin-top: var(--space-7);
  }

  /* The Markdown body: The problem, What I did, Outcome, What I learned, Credits. */
  .body {
    margin-top: var(--space-7);
  }

  .body > :global(* + *) {
    margin-top: var(--space-4);
  }

  .body > :global(h2:not(:first-child)) {
    margin-top: var(--space-7);
  }

  .pager {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }

  .next {
    margin-left: auto;
  }

  /* On a phone the buttons fill the column, as in the wireframe. */
  @media (width < 48em) {
    .actions .button,
    .pager .button {
      flex: 1 1 100%;
    }
  }

  @media (width >= 48em) {
    .details {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
