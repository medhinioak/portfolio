---
/** Decorative arrow icon for small buttons; the button's text carries the meaning. */
interface Props {
  direction: 'left' | 'right';
}

const { direction } = Astro.props;
const path =
  direction === 'right' ? 'M2 8h11M9 4l4 4-4 4' : 'M14 8H3M7 4 3 8l4 4';
---

<svg
  aria-hidden="true"
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
>
  <path d={path}></path>
</svg>
