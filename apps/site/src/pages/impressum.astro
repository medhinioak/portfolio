---
/** Impressum (legal notice) under § 5 DDG and § 18 MStV (issue #33). */
import BaseLayout from '../layouts/BaseLayout.astro';
import { email, legalName, mailtoHref } from '../lib/contact';
---

<BaseLayout
  title="Impressum · Medhini Oak"
  description="PLACEHOLDER: one-sentence description of the Impressum page"
>
  <section class="legal" aria-labelledby="impressum-title">
    <h1 id="impressum-title">Impressum</h1>
    <p>
      Information under § 5 DDG. Responsible for the content under § 18 (2)
      MStV:
    </p>
    <dl>
      <dt>Name</dt>
      <dd>{legalName}</dd>
      <dt>Email</dt>
      <dd>
        <a href={mailtoHref(email)}>{email}</a>
      </dd>
    </dl>
  </section>
</BaseLayout>

<style>
  .legal {
    display: grid;
    gap: var(--space-5);
  }

  dl {
    display: grid;
    gap: var(--space-2);
  }

  dt {
    font-weight: 700;
  }
</style>
