---
/** Home page: intro with the CV link, Projects, then the Contact section (issues #29, #30). */
import Arrow from '../components/Arrow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedProjects } from '../lib/get-projects';
import {
  channels,
  cvUrl,
  email,
  mailSubject,
  mailtoHref,
} from '../lib/contact';

const projects = (await getPublishedProjects()).slice(0, 2);
---

<BaseLayout
  title="Medhini Oak"
  description="PLACEHOLDER: one-sentence description of the Home page"
>
  <section class="intro" aria-labelledby="intro-title">
    <h1 id="intro-title">PLACEHOLDER: one-line headline</h1>
    <!-- TEMPORARY failing check for issue #12: revert. -->
    <img src="/does-not-exist.png" width="40" height="40" />
    <p style="color: #bbb; background: #fff">Low-contrast text for the failing check.</p>
    <p class="role">
      PLACEHOLDER: short role line
      <span class="role-bar" aria-hidden="true"></span>
    </p>
    <p>
      PLACEHOLDER: 2–3 sentences on who I am, what I do and what I am looking
      for.
    </p>
    <a class="button button-primary" href={cvUrl}>
      Read my CV
    </a>
  </section>

  {projects.length > 0 && (
    <section class="projects" aria-labelledby="projects-title">
      <div class="section-head">
        <h2 id="projects-title">Projects</h2>
        <a class="button button-secondary button-small" href="/projects/">
          All projects
          <Arrow direction="right" />
        </a>
      </div>
      {projects.map((project) => (
        <ProjectCard project={project} headingLevel={3} />
      ))}
    </section>
  )}

  <!-- Blog (#32) goes here. The game teaser waits for Phase 3. -->

  <section id="contact" class="contact" aria-labelledby="contact-title">
    <h2 id="contact-title">Contact</h2>
    <p>PLACEHOLDER: one line inviting people to get in touch.</p>
    <div class="row">
      <a class="button button-primary" href={mailtoHref(email, mailSubject)}>
        Email me
      </a>
      <a class="button button-secondary" href={channels.github.href}>
        {channels.github.label}
      </a>
      <a class="button button-secondary" href={channels.linkedin.href}>
        {channels.linkedin.label}
      </a>
    </div>
    <p class="muted">Prefer to copy it? {email}</p>

    <h3>Videos and streams</h3>
    <div class="row">
      <a class="button button-secondary" href={channels.youtube.href}>
        {channels.youtube.label}
      </a>
      <a class="button button-secondary" href={channels.twitch.href}>
        {channels.twitch.label}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .intro,
  .contact {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .projects {
    display: grid;
    gap: var(--space-4);
  }

  .projects,
  .contact {
    margin-top: var(--space-7);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .role {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: calc(-1 * var(--space-2));
    font-family: var(--font-pixel);
    font-size: var(--text-lg);
    color: var(--color-muted);
  }

  .role-bar {
    flex: none;
    width: var(--space-3);
    height: var(--space-1);
    background: var(--color-highlight);
  }

  .contact h3 {
    margin-top: var(--space-4);
  }
</style>
