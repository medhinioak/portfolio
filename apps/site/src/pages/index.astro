---
/** Home page stub until Phase 1 content lands: "Coming soon" plus a type specimen. */
import BaseLayout from '../layouts/BaseLayout.astro';

const swatches = [
  'bg',
  'surface',
  'text',
  'muted',
  'accent',
  'on-accent',
  'highlight',
] as const;
---

<BaseLayout
  title="medhinioak.dev"
  description="Personal site and blog. Coming soon."
>
  <section class="intro">
    <h1>medhinioak.dev</h1>
    <p class="lead">
      Coming soon
      <span class="cursor" aria-hidden="true">
        _
      </span>
    </p>
  </section>

  <section class="specimen" aria-labelledby="specimen-title">
    <p class="label muted" id="specimen-title">
      Type specimen
    </p>
    <h2>Heading two</h2>
    <h3>Heading three</h3>
    <h4>Heading four</h4>
    <p>
      Body text is set in Atkinson Hyperlegible, designed for readers with low
      vision. It has <strong>bold</strong>, <em>italic</em>,{' '}
      <a href="#specimen-title">a link</a> and
      <code>inline_code()</code> in the system monospace font.
    </p>
    <p class="muted">
      Muted text is for dates, captions and other secondary details.
    </p>

    <ul class="swatches" aria-label="Colour tokens">
      {swatches.map((name) => (
        <li class="swatch">
          <span
            class="swatch-colour"
            style={`background: var(--color-${name})`}
          />
          <code>--color-{name}</code>
        </li>
      ))}
    </ul>
  </section>

  <section class="ui" aria-labelledby="ui-title">
    <p class="label muted" id="ui-title">
      UI specimen
    </p>
    <div class="row">
      <a class="button button-primary" href="#ui-title">
        Primary button
      </a>
      <a class="button button-secondary" href="#ui-title">
        Secondary button
      </a>
    </div>
    <div class="row">
      <a class="button button-secondary button-small" href="#ui-title">
        Small button
        <svg
          aria-hidden="true"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M2 8h11M9 4l4 4-4 4" />
        </svg>
      </a>
      <a class="button button-secondary button-small" href="#ui-title">
        <svg aria-hidden="true" viewBox="0 0 16 16" fill="currentColor">
          <circle cx="3" cy="13" r="2" />
          <path d="M1 7a8 8 0 0 1 8 8h-2a6 6 0 0 0-6-6zM1 2a13 13 0 0 1 13 13h-2A11 11 0 0 0 1 4z" />
        </svg>
        Feed button
      </a>
    </div>
    <div class="card">
      <h3 class="title-long">
        <a href="#ui-title">Card with a long title</a>
      </h3>
      <p>A card holds a title link, a one-line summary and chips.</p>
      <ul class="chips" aria-label="Tags">
        <li class="chip">tag</li>
        <li class="chip">another tag</li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    margin-bottom: var(--space-7);
  }

  .lead {
    margin-top: var(--space-3);
    font-family: var(--font-pixel);
    font-size: var(--text-lg);
    color: var(--color-muted);
  }

  .cursor {
    color: var(--color-highlight);
  }

  .specimen {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--color-surface);
    border-radius: var(--radius);
  }

  .specimen code {
    background: var(--color-bg);
  }

  .ui {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .row,
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .chips {
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .swatch {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .swatch-colour {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    border: 2px solid var(--color-text);
    border-radius: var(--radius);
  }
</style>
