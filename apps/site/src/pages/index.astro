---
/** Home page: intro with the CV link, Projects, the latest post, the game teaser, then Contact (issues #29, #30, #32, #77). */
import Arrow from '../components/Arrow.astro';
import FeedIcon from '../components/FeedIcon.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import heroGif from '../assets/hero-animation.gif';
import heroStill from '../assets/hero-still.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/get-posts';
import { getPublishedProjects } from '../lib/get-projects';
import {
  channels,
  cvUrl,
  email,
  mailSubject,
  mailtoHref,
  repoUrl,
} from '../lib/contact';
import { personJsonLd } from '../lib/seo';

const projects = (await getPublishedProjects()).slice(0, 2);
const [latestPost] = await getPublishedPosts();
if (!Astro.site) throw new Error('Set `site` in astro.config.mjs.');
const person = personJsonLd(
  new URL('/', Astro.site).href,
  Object.values(channels).map((channel) => channel.href),
);
---

<BaseLayout
  title="Medhini Oak"
  description="Hi, I'm Medhini, a software engineer open to roles in Germany. Projects, a blog and the occasional cat sighting."
  jsonLd={person}
>
  <section class="intro" aria-labelledby="intro-title">
    {/* Plain .src, not <Image>: a transform could drop the GIF's frames. Top image, so not lazy. */}
    <picture class="hero-art">
      <source media="(prefers-reduced-motion: reduce)" srcset={heroStill.src} />
      <img
        src={heroGif.src}
        alt=""
        width="320"
        height="428"
        fetchpriority="high"
      />
    </picture>
    <div class="intro-text">
      <h1 id="intro-title">
        Hi, I'm Medhini. Welcome to my corner of the web.
      </h1>
      <p class="role">
        5 years as a software engineer · Open to roles in{' '}
        <span class="role-end">
          Germany<span class="role-bar" aria-hidden="true"></span>
        </span>
      </p>
      <p>
        I'm a software engineer with five years of experience, and in that time
        I've worn a lot of hats: frontend, backend, data, cloud, DevOps and AI.
        Call me a jack of all trades, just one who keeps picking up new tricks
        and has no plans to stop learning.
      </p>
      <p>
        This site is my personal project, built like a serious piece of
        engineering (the <a href={repoUrl}>source is on GitHub</a>, if you want
        to look under the hood). It's my showcase for everything I make,
        technical or not, plus a blog about what I learn along the way. Poke
        around, and say hello if you like.
      </p>
      <a class="button button-primary" href={cvUrl}>
        Read my CV
      </a>
    </div>
  </section>

  {projects.length > 0 && (
    <section class="projects" aria-labelledby="projects-title">
      <div class="section-head">
        <h2 id="projects-title">Projects</h2>
        <a class="button button-secondary button-small" href="/projects/">
          All projects
          <Arrow direction="right" />
        </a>
      </div>
      {projects.map((project) => (
        <ProjectCard project={project} headingLevel={3} />
      ))}
    </section>
  )}

  {latestPost && (
    <section class="blog" aria-labelledby="blog-title">
      <div class="section-head">
        <h2 id="blog-title">Blog</h2>
        <div class="row">
          <a class="button button-secondary button-small" href="/blog/">
            All posts
            <Arrow direction="right" />
          </a>
          <a
            class="button button-secondary button-small"
            href="/blog/#subscribe"
          >
            <FeedIcon />
            RSS
          </a>
        </div>
      </div>
      <PostCard post={latestPost} headingLevel={3} />
    </section>
  )}

  {/* Plain links only: the game's JavaScript loads on /play, not here. */}
  <section class="game-teaser" aria-labelledby="game-title">
    <h2 id="game-title">Tail Trail</h2>
    <p>
      Ask yes/no questions and find the computer's secret animal before it finds
      yours.
    </p>
    <a class="button button-primary" href="/play/">
      Play Tail Trail
    </a>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-title">
    <h2 id="contact-title">Contact</h2>
    <p>
      Got a project, a question or a cat photo? My inbox is open, and I reply
      faster than my CI runs.
    </p>
    <div class="row">
      <a class="button button-primary" href={mailtoHref(email, mailSubject)}>
        Email me
      </a>
      <a class="button button-secondary" href={channels.github.href}>
        {channels.github.label}
      </a>
      <a class="button button-secondary" href={channels.linkedin.href}>
        {channels.linkedin.label}
      </a>
    </div>
    <p class="muted">Prefer to copy it? {email}</p>

    <h3>Videos and streams</h3>
    <div class="row">
      <a class="button button-secondary" href={channels.youtube.href}>
        {channels.youtube.label}
      </a>
      <a class="button button-secondary" href={channels.twitch.href}>
        {channels.twitch.label}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* The art sits above the text on a phone and beside it from 48em. */
  .intro {
    display: grid;
    gap: var(--space-5);
  }

  /* Centred above the text on a phone; beside it, its column is exactly its width. */
  .hero-art {
    justify-self: center;
  }

  @media (width >= 48em) {
    .intro {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .hero-art {
      grid-column: 2;
      grid-row: 1;
    }
  }

  /* 320 × 428 file at 2×, shown 160 px wide. */
  .hero-art img {
    width: 10rem;
    height: auto;
  }

  .intro-text,
  .game-teaser,
  .contact {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .projects,
  .blog {
    display: grid;
    gap: var(--space-4);
  }

  .projects,
  .blog,
  .game-teaser,
  .contact {
    margin-top: var(--space-7);
  }

  /* The dashed box of the wireframe (docs/design/wireframes.md, Home item 4). */
  .game-teaser {
    padding: var(--space-5);
    border: 2px dashed var(--color-muted);
    border-radius: var(--radius);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .role {
    margin-top: calc(-1 * var(--space-2));
    font-family: var(--font-pixel);
    font-size: var(--text-lg);
    color: var(--color-muted);
  }

  /* The last word and the cursor wrap together, so the cursor never sits alone. */
  .role-end {
    white-space: nowrap;
  }

  /* A terminal-style cursor resting on the baseline right after the last word. */
  .role-bar {
    display: inline-block;
    width: var(--space-3);
    height: var(--space-1);
    margin-left: var(--space-1);
    background: var(--color-highlight);
  }

  .contact h3 {
    margin-top: var(--space-4);
  }
</style>
